                    <HBox prefHeight="100.0" prefWidth="200.0" spacing="10.0" AnchorPane.bottomAnchor="15.0" AnchorPane.leftAnchor="15.0" AnchorPane.rightAnchor="15.0" AnchorPane.topAnchor="15.0">
                        <AnchorPane prefHeight="200.0" prefWidth="200.0" HBox.hgrow="ALWAYS">
                            <TextField fx:id="inputBuscarProducto" layoutX="133.0" layoutY="18.0" prefHeight="60.0" prefWidth="456.0" promptText="Buscar Productos" AnchorPane.bottomAnchor="0.0" AnchorPane.leftAnchor="0.0" AnchorPane.rightAnchor="0.0" AnchorPane.topAnchor="0.0">
                                <font>
                                    <Font size="15.0" />
                                </font>
                            </TextField>
                        </AnchorPane>
                        <AnchorPane prefHeight="200.0" prefWidth="100.0">
                            <MenuButton fx:id="btnFiltrarProducto" mnemonicParsing="false" prefHeight="35.0" prefWidth="100.0" text="Filtrar" AnchorPane.bottomAnchor="0.0" AnchorPane.leftAnchor="0.0" AnchorPane.rightAnchor="0.0" AnchorPane.topAnchor="0.0">
                                <items>
                                    <MenuItem mnemonicParsing="false" text="Código de Barra" />
                                    <MenuItem mnemonicParsing="false" text="Descripción" />
                                    <MenuItem mnemonicParsing="false" text="Precio de Venta" />
                                </items>
                                <graphic>
                                    <FontAwesomeIconView glyphName="FILTER" size="15.0" />
                                </graphic>
                                <font>
                                    <Font size="15.0" />
                                </font>
                            </MenuButton>
                        </AnchorPane>
                    </HBox>
                </AnchorPane>
            </AnchorPane>
            <AnchorPane prefHeight="600.0" VBox.vgrow="ALWAYS">
                <HBox prefHeight="600.0" prefWidth="870.0" spacing="10.0" AnchorPane.bottomAnchor="10.0" AnchorPane.leftAnchor="20.0" AnchorPane.rightAnchor="20.0" AnchorPane.topAnchor="10.0">
                    <AnchorPane prefHeight="198.0" prefWidth="521.0" HBox.hgrow="ALWAYS">
                        <VBox styleClass="anchorPaneStat" AnchorPane.bottomAnchor="0.0" AnchorPane.leftAnchor="0.0" AnchorPane.rightAnchor="0.0" AnchorPane.topAnchor="0.0">
                            <AnchorPane VBox.vgrow="ALWAYS">
