<?xml version="1.0" encoding="UTF-8"?>

<?import de.jensd.fx.glyphs.fontawesome.FontAwesomeIconView?>
<?import javafx.geometry.Insets?>
<?import javafx.scene.control.*?>
<?import javafx.scene.image.ImageView?>
<?import javafx.scene.layout.*?>
<?import javafx.scene.text.*?>

<AnchorPane layoutX="14.0" layoutY="14.0" prefHeight="560.0" prefWidth="885.0" style="-fx-background-color: #FFFFFF;"
            xmlns="http://javafx.com/javafx/20.0.2" xmlns:fx="http://javafx.com/fxml/1" fx:controller="com.controller.ProductosController">
    <HBox layoutX="15.0" layoutY="105.0" AnchorPane.bottomAnchor="12.0" AnchorPane.leftAnchor="15.0"
          AnchorPane.rightAnchor="15.0" AnchorPane.topAnchor="160.0">
        <TableView fx:id="tableProductos" prefHeight="200.0" prefWidth="600.0" HBox.hgrow="ALWAYS">
            <columns>
                <TableColumn fx:id="columnCodigoProducto" prefWidth="75.0" text="Código"/>
                <TableColumn fx:id="columnDescripcionProducto" prefWidth="75.0" text="Descripción"/>
                <TableColumn fx:id="columnMarcaProducto" prefWidth="75.0" text="Marca"/>
                <TableColumn fx:id="columnRubroProducto" prefWidth="75.0" text="Rubro"/>
                <TableColumn fx:id="columnPrecioVentaProducto" prefWidth="75.0" text="Precio Venta"/>
                <TableColumn fx:id="columnStockProducto" prefWidth="75.0" text="Stock"/>
            </columns>
            <columnResizePolicy>
                <TableView fx:constant="CONSTRAINED_RESIZE_POLICY"/>
            </columnResizePolicy>
        </TableView>
        <AnchorPane prefHeight="443.0" prefWidth="190.0" style="-fx-border-color: black;" HBox.hgrow="ALWAYS">
            <HBox.margin>
                <Insets left="10.0"/>
            </HBox.margin>
            <VBox layoutY="243.0" prefHeight="200.0" prefWidth="100.0" AnchorPane.bottomAnchor="0.0"
                  AnchorPane.leftAnchor="0.0" AnchorPane.rightAnchor="0.0" AnchorPane.topAnchor="0.0">
                <Pane prefHeight="35.0" prefWidth="243.0" style="-fx-border-color: gray;">
                    <Text layoutX="15.0" layoutY="23.0" strokeType="OUTSIDE" strokeWidth="0.0"
                          text="Producto Seleccionado">
                        <font>
                            <Font name="System Bold" size="15.0"/>
                        </font>
                    </Text>
                </Pane>
                <Pane prefHeight="150.0" prefWidth="200.0" VBox.vgrow="ALWAYS">
                    <ImageView fitHeight="125.0" fitWidth="170.0" layoutX="23.0" layoutY="9.0"
                               pickOnBounds="true" preserveRatio="true"/>
                </Pane>
                <Pane prefHeight="35.0" prefWidth="200.0">
                    <Text fx:id="txtCodigoProducto" layoutX="15.0" layoutY="22.0" strokeType="OUTSIDE"
                          strokeWidth="0.0" text="Código:"/>
                </Pane>
                <Pane layoutX="10.0" layoutY="245.0" prefHeight="35.0" prefWidth="200.0">
                    <Text layoutX="15.0" layoutY="22.0" strokeType="OUTSIDE" strokeWidth="0.0"
                          text="Descripcion:"/>
                </Pane>
                <Pane layoutX="10.0" layoutY="280.0" prefHeight="35.0" prefWidth="200.0">
                    <Text fx:id="txtMarcaProducto" layoutX="15.0" layoutY="22.0" strokeType="OUTSIDE"
                          strokeWidth="0.0" text="Marca:"/>
                </Pane>
                <Pane layoutX="10.0" layoutY="315.0" prefHeight="35.0" prefWidth="200.0">
                    <Text fx:id="txtRubroProducto" layoutX="15.0" layoutY="22.0" strokeType="OUTSIDE"
                          strokeWidth="0.0" text="Rubro:"/>
                </Pane>
                <Pane layoutX="10.0" layoutY="350.0" prefHeight="35.0" prefWidth="200.0">
                    <Text fx:id="txtPrecioVentaProducto" layoutX="15.0" layoutY="22.0"
                          strokeType="OUTSIDE" strokeWidth="0.0" text="Precio de Venta:"/>
                </Pane>
                <Pane layoutX="10.0" layoutY="335.0" prefHeight="35.0" prefWidth="200.0">
                    <Text fx:id="txtPrecioCompraProducto" layoutX="15.0" layoutY="22.0"
                          strokeType="OUTSIDE" strokeWidth="0.0" text="Precio de Compra:"/>
                </Pane>
                <Pane layoutX="10.0" layoutY="370.0" prefHeight="35.0" prefWidth="200.0">
                    <Text layoutX="15.0" layoutY="22.0" strokeType="OUTSIDE" strokeWidth="0.0"
                          text="Stock:"/>
                </Pane>
                <HBox prefHeight="42.0" prefWidth="200.0" VBox.vgrow="ALWAYS">
                    <AnchorPane prefHeight="200.0" prefWidth="200.0">
                        <Button fx:id="btnEditarProducto" layoutX="27.0" layoutY="2.0"
                                mnemonicParsing="false" prefHeight="32.0" prefWidth="106.0"
                                text="Editar" AnchorPane.bottomAnchor="5.0"
                                AnchorPane.leftAnchor="5.0" AnchorPane.rightAnchor="5.0"
                                AnchorPane.topAnchor="5.0"/>
                    </AnchorPane>
                    <AnchorPane prefHeight="200.0" prefWidth="200.0">
                        <Button fx:id="btnEliminarProducto" layoutX="28.0" layoutY="2.0"
                                mnemonicParsing="false" prefHeight="32.0" prefWidth="107.0"
                                text="Eliminar" AnchorPane.bottomAnchor="5.0"
                                AnchorPane.leftAnchor="5.0" AnchorPane.rightAnchor="5.0"
                                AnchorPane.topAnchor="5.0"/>
                    </AnchorPane>
                </HBox>
            </VBox>
        </AnchorPane>
    </HBox>
    <HBox layoutX="15.0" layoutY="14.0" prefHeight="160.0" prefWidth="200.0" AnchorPane.leftAnchor="15.0"
          AnchorPane.rightAnchor="15.0" AnchorPane.topAnchor="0.0">
        <AnchorPane prefHeight="200.0" prefWidth="200.0" HBox.hgrow="ALWAYS">
            <VBox layoutX="14.0" layoutY="102.0" prefHeight="42.0" prefWidth="174.0">
                <Text strokeType="OUTSIDE" strokeWidth="0.0" text="Marca"/>
                <TextField fx:id="inputSearchMarcaProducto" prefHeight="25.0" prefWidth="90.0"/>
            </VBox>
            <VBox layoutX="234.0" layoutY="102.0" prefHeight="42.0" prefWidth="174.0">
                <Text strokeType="OUTSIDE" strokeWidth="0.0" text="Rubro"/>
                <TextField fx:id="inputSearchRubroProducto" prefHeight="25.0" prefWidth="90.0"/>
            </VBox>
            <VBox layoutX="14.0" layoutY="58.0" prefHeight="42.0" prefWidth="174.0">
                <Text strokeType="OUTSIDE" strokeWidth="0.0" text="Código"/>
                <TextField fx:id="inputSearchCodigoProducto" prefHeight="25.0" prefWidth="90.0"/>
            </VBox>
            <VBox layoutX="234.0" layoutY="60.0" prefHeight="42.0" prefWidth="174.0">
                <Text strokeType="OUTSIDE" strokeWidth="0.0" text="Descripción"/>
                <TextField fx:id="inputSearchDescripcionProducto" prefHeight="25.0" prefWidth="90.0"/>
            </VBox>
            <HBox alignment="CENTER_LEFT" layoutX="14.0" layoutY="14.0" prefHeight="30.0" prefWidth="127.0">
                <FontAwesomeIconView glyphName="TAG" layoutX="10.0" layoutY="33.0" size="20"/>
                <Text strokeType="OUTSIDE" strokeWidth="0.0" text="Productos">
                    <font>
                        <Font name="System Bold" size="18.0"/>
                    </font>
                    <HBox.margin>
                        <Insets left="8.0"/>
                    </HBox.margin>
                </Text>
            </HBox>
        </AnchorPane>
        <AnchorPane prefHeight="200.0" prefWidth="200.0" HBox.hgrow="ALWAYS">
            <Button fx:id="btnAniadirProducto" layoutX="110.0" layoutY="127.0" mnemonicParsing="false"
                    text="Añadir">
                <graphic>
                    <FontAwesomeIconView glyphName="PLUS"/>
                </graphic>
            </Button>
        </AnchorPane>
    </HBox>
</AnchorPane>
