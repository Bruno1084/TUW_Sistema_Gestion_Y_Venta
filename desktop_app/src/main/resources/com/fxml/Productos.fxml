                  <FontAwesomeIconView glyphName="PLUS" size="15.0" text="" />
               </graphic>
               <font>
                  <Font name="System Bold" size="15.0" />
               </font>
            </Button>
            <MenuButton fx:id="btnConfigProducto" layoutX="809.0" layoutY="8.0" mnemonicParsing="false" prefHeight="30.0" prefWidth="39.0" AnchorPane.rightAnchor="20.0">
