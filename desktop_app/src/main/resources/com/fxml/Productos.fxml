                                        <TableColumn fx:id="columnDescripcionProducto" prefWidth="75.0" text="Descripción" />
                                        <TableColumn fx:id="columnMarcaProducto" prefWidth="75.0" text="Marca" />
                                        <TableColumn fx:id="columnRubroProducto" prefWidth="75.0" text="Rubro" />
                                        <TableColumn fx:id="columnPrecioVentaProducto" prefWidth="75.0" text="Precio Venta" />
                                        <TableColumn fx:id="columnStockProducto" prefWidth="75.0" text="Stock" />
                                    </columns>
                                    <columnResizePolicy>
                                        <TableView fx:constant="CONSTRAINED_RESIZE_POLICY" />
                                    </columnResizePolicy>
                                </TableView>
                            </AnchorPane>
                        </VBox>
                    </AnchorPane>
                </HBox>
            </AnchorPane>
        </VBox>
    </ScrollPane>
