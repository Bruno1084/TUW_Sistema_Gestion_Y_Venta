<AnchorPane id="anchorPaneMain" fx:id="rootPane" prefHeight="560.0" prefWidth="885.0" stylesheets="@../css/productos.css" xmlns="http://javafx.com/javafx/24.0.1" xmlns:fx="http://javafx.com/fxml/1" fx:controller="com.controller.ProductosController">
    <ScrollPane fitToWidth="true" prefHeight="560.0" prefWidth="885.0" AnchorPane.bottomAnchor="0.0" AnchorPane.leftAnchor="0.0" AnchorPane.rightAnchor="0.0" AnchorPane.topAnchor="0.0">
        <VBox id="vBoxMainContainer" prefWidth="885.0">
            <AnchorPane prefHeight="45.0">
                <Text layoutX="14.0" layoutY="30.0" strokeType="OUTSIDE" strokeWidth="0.0" text="Productos" AnchorPane.leftAnchor="20.0">
                    <font>
                        <Font name="System Bold" size="20.0" />
                    </font>
                </Text>
            <Button fx:id="btnAniadirProducto" layoutX="713.0" layoutY="8.0" mnemonicParsing="false" onAction="#handleAniadirProducto" AnchorPane.rightAnchor="70.0">
