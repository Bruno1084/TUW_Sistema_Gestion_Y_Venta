                        <TableColumn fx:id="columnProveedorCompra" prefWidth="75.0" text="Proveedor" />
                        <TableColumn fx:id="columnComprasTotalesCompra" prefWidth="75.0" text="Compras Totales" />
                        <TableColumn fx:id="columnPrecioTotalCompra" prefWidth="75.0" text="Precio Total" />
                    </columns>
                    <columnResizePolicy>
                        <TableView fx:constant="CONSTRAINED_RESIZE_POLICY" />
                    </columnResizePolicy>
                </TableView>
            </AnchorPane>
        </VBox>
