                        </HBox.margin>
                    </Button>
                </HBox>
            </HBox>
            <AnchorPane prefHeight="200.0" prefWidth="200.0" VBox.vgrow="ALWAYS">
                <TableView fx:id="tableCompras" layoutX="242.0" layoutY="88.0" prefHeight="433.0" prefWidth="883.0" AnchorPane.bottomAnchor="0.0" AnchorPane.leftAnchor="0.0" AnchorPane.rightAnchor="0.0" AnchorPane.topAnchor="0.0">
