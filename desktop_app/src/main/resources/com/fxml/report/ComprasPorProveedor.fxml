<?import javafx.scene.layout.AnchorPane?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.VBox?>
<?import javafx.scene.text.Font?>
<?import javafx.scene.text.Text?>

<AnchorPane prefHeight="560.0" prefWidth="885.0" xmlns="http://javafx.com/javafx/24.0.1" xmlns:fx="http://javafx.com/fxml/1" fx:controller="com.controller.report.ComprasPorProveedorController">
    <ScrollPane fitToHeight="true" fitToWidth="true" layoutX="218.0" layoutY="195.0" prefHeight="560.0" prefWidth="885.0" AnchorPane.bottomAnchor="0.0" AnchorPane.leftAnchor="0.0" AnchorPane.rightAnchor="0.0" AnchorPane.topAnchor="0.0">
        <VBox>
            <padding>
                <Insets left="20.0" right="20.0" />
            </padding>
            <AnchorPane prefHeight="45.0">
                <Text layoutX="14.0" layoutY="30.0" strokeType="OUTSIDE" strokeWidth="0.0" text="Compras por Proveedor" AnchorPane.leftAnchor="0.0">
                    <font>
                        <Font name="System Bold" size="20.0" />
                    </font>
                </Text>
            </AnchorPane>
            <HBox alignment="CENTER_LEFT" prefHeight="50.0" prefWidth="883.0" spacing="10.0">
                <HBox alignment="CENTER" spacing="2.0">
                    <HBox.margin>
                        <Insets />
                    </HBox.margin>
                    <FontAwesomeIconView glyphName="FILTER" size="18" />
                    <Text strokeType="OUTSIDE" strokeWidth="0.0" text="Filtros: " />
                </HBox>
                <MenuButton fx:id="menuButtonFechas" mnemonicParsing="false" text="Intervalo de Fechas">
                    <items>
                        <MenuItem fx:id="menuItemHoy" mnemonicParsing="false" text="Hoy" />
                        <MenuItem fx:id="menuItemEstaSemana" mnemonicParsing="false" text="Esta Semana" />
                        <MenuItem fx:id="menuItemEsteMes" mnemonicParsing="false" text="Este Mes" />
                    </items>
                </MenuButton>
                <HBox alignment="CENTER_RIGHT" HBox.hgrow="ALWAYS">
                    <Button fx:id="btnExportar" mnemonicParsing="false" text="Exportar">
