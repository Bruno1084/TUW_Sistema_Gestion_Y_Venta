<?xml version="1.0" encoding="UTF-8"?>

<?import de.jensd.fx.glyphs.fontawesome.FontAwesomeIconView?>
<?import javafx.geometry.Insets?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.TableColumn?>
<?import javafx.scene.control.TableView?>
<?import javafx.scene.control.TextField?>
<?import javafx.scene.layout.AnchorPane?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.VBox?>
<?import javafx.scene.text.Font?>
<?import javafx.scene.text.Text?>

<AnchorPane prefWidth="650.0" xmlns="http://javafx.com/javafx/24.0.1" xmlns:fx="http://javafx.com/fxml/1"
            fx:controller="com.controller.modal.ModalCompraController">
    <VBox layoutX="216.0" layoutY="50.0" prefWidth="500.0" AnchorPane.bottomAnchor="0.0" AnchorPane.leftAnchor="0.0"
          AnchorPane.rightAnchor="0.0" AnchorPane.topAnchor="0.0">
        <AnchorPane maxHeight="-Infinity" minHeight="-Infinity" prefHeight="40.0" prefWidth="200.0">
            <Text layoutX="14.0" layoutY="27.0" strokeType="OUTSIDE" strokeWidth="0.0"
                  text="Añadir Compra" AnchorPane.leftAnchor="14.0">
                <font>
                    <Font name="System Bold" size="18.0"/>
                </font>
            </Text>
        </AnchorPane>
        <AnchorPane layoutX="10.0" layoutY="80.0" maxHeight="-Infinity" minHeight="-Infinity">
            <HBox spacing="15.0" AnchorPane.bottomAnchor="0.0" AnchorPane.leftAnchor="15.0"
                  AnchorPane.rightAnchor="15.0" AnchorPane.topAnchor="0.0">
                <HBox>
                    <Text strokeType="OUTSIDE" strokeWidth="0.0" text="ID: ">
                        <font>
                            <Font size="14.0"/>
                        </font>
                    </Text>
                    <TextField fx:id="inputIdCompra"/>
                </HBox>
                <HBox>
                    <Text strokeType="OUTSIDE" strokeWidth="0.0" text="Fecha: ">
                        <font>
                            <Font size="14.0"/>
                        </font>
                    </Text>
                    <TextField fx:id="inputFechaCompra"/>
                </HBox>
            </HBox>
        </AnchorPane>
        <AnchorPane layoutX="10.0" layoutY="80.0" maxHeight="-Infinity" minHeight="-Infinity">
            <VBox layoutX="175.0" layoutY="-62.0" AnchorPane.leftAnchor="0.0" AnchorPane.rightAnchor="0.0"
                  AnchorPane.topAnchor="0.0">
                <AnchorPane prefHeight="40.0" prefWidth="650.0">
                    <Text layoutX="14.0" layoutY="26.0" strokeType="OUTSIDE" strokeWidth="0.0"
                          text="Proveedor" AnchorPane.leftAnchor="15.0">
                        <font>
                            <Font name="System Bold" size="16.0"/>
                        </font>
                    </Text>
                </AnchorPane>
                <AnchorPane layoutX="10.0" layoutY="10.0">
                    <VBox.margin>
                        <Insets bottom="8.0"/>
                    </VBox.margin>
                    <HBox layoutX="75.0" layoutY="-10.0" prefWidth="200.0" spacing="15.0"
                          AnchorPane.leftAnchor="15.0" AnchorPane.rightAnchor="15.0"
                          AnchorPane.topAnchor="0.0">
                        <HBox HBox.hgrow="ALWAYS">
                            <Text strokeType="OUTSIDE" strokeWidth="0.0" text="ID: ">
                                <font>
                                    <Font size="14.0"/>
                                </font>
                            </Text>
                            <TextField fx:id="inputIdProveedor"/>
                        </HBox>
                        <HBox layoutX="10.0" layoutY="10.0" HBox.hgrow="ALWAYS">
                            <Text strokeType="OUTSIDE" strokeWidth="0.0" text="Nombre: ">
                                <font>
                                    <Font size="14.0"/>
                                </font>
                            </Text>
                            <TextField fx:id="inputNombreProveedor"/>
                        </HBox>
                    </HBox>
                </AnchorPane>
                <AnchorPane layoutX="10.0" layoutY="50.0">
                    <HBox layoutX="75.0" layoutY="-10.0" prefWidth="200.0" spacing="15.0"
                          AnchorPane.leftAnchor="15.0" AnchorPane.rightAnchor="15.0"
                          AnchorPane.topAnchor="0.0">
                        <HBox HBox.hgrow="ALWAYS">
                            <Text strokeType="OUTSIDE" strokeWidth="0.0" text="Teléfono: ">
                                <font>
                                    <Font size="14.0"/>
                                </font>
                            </Text>
                            <TextField fx:id="inputTelefonoProveedor"/>
                        </HBox>
                        <HBox layoutX="10.0" layoutY="10.0" HBox.hgrow="ALWAYS">
                            <Text strokeType="OUTSIDE" strokeWidth="0.0" text="Dirección: ">
                                <font>
                                    <Font size="14.0"/>
                                </font>
                            </Text>
                            <TextField fx:id="inputDireccionProveedor"/>
                        </HBox>
                    </HBox>
                </AnchorPane>
            </VBox>
        </AnchorPane>
        <AnchorPane layoutX="10.0" layoutY="360.0" maxHeight="-Infinity" minHeight="-Infinity" prefHeight="400.0"
                    VBox.vgrow="ALWAYS">
            <VBox layoutX="225.0" layoutY="-75.0" AnchorPane.bottomAnchor="0.0" AnchorPane.leftAnchor="0.0"
                  AnchorPane.rightAnchor="0.0" AnchorPane.topAnchor="0.0">
                <AnchorPane prefHeight="40.0" prefWidth="650.0">
                    <Text layoutX="14.0" layoutY="20.0" strokeType="OUTSIDE" strokeWidth="0.0"
                          text="Productos" AnchorPane.leftAnchor="15.0">
                        <font>
                            <Font name="System Bold" size="16.0"/>
                        </font>
                    </Text>
                </AnchorPane>
                <AnchorPane prefWidth="650.0">
                    <HBox layoutX="244.0" layoutY="-18.0" prefWidth="650.0"
                          AnchorPane.bottomAnchor="0.0" AnchorPane.leftAnchor="0.0"
                          AnchorPane.rightAnchor="0.0" AnchorPane.topAnchor="0.0">
                        <AnchorPane prefWidth="200.0" HBox.hgrow="ALWAYS">
                            <TextField fx:id="inputCodigoBarraProducto" layoutX="72.0"
                                       layoutY="10.0" promptText="Código"
                                       AnchorPane.leftAnchor="72.0"/>
                            <Button fx:id="btnBuscarProducto" layoutX="228.0" layoutY="11.0"
                                    mnemonicParsing="false" onAction="#handleBtnBuscarProducto"
                                    AnchorPane.leftAnchor="228.0">
                                <graphic>
                                    <FontAwesomeIconView glyphName="SEARCH" size="15"/>
                                </graphic>
                            </Button>
                            <Text layoutX="14.0" layoutY="28.0" strokeType="OUTSIDE"
                                  strokeWidth="0.0" text="Código:" AnchorPane.leftAnchor="15.0">
                                <font>
                                    <Font name="System Bold" size="14.0"/>
                                </font>
                            </Text>
                        </AnchorPane>
                        <AnchorPane prefWidth="200.0" HBox.hgrow="ALWAYS">
                            <TextField fx:id="inputTotalProducto" layoutX="133.0" layoutY="9.0"
                                       AnchorPane.rightAnchor="15.0"/>
                            <Text layoutX="85.0" layoutY="28.0" strokeType="OUTSIDE"
                                  strokeWidth="0.0" text="Total:">
                                <font>
                                    <Font name="System Bold" size="14.0"/>
                                </font>
                            </Text>
                        </AnchorPane>
                    </HBox>
                </AnchorPane>
                <AnchorPane VBox.vgrow="ALWAYS">
                    <VBox.margin>
                        <Insets top="10.0"/>
                    </VBox.margin>
                    <TableView fx:id="tableProductos" layoutX="225.0" layoutY="-9.0"
                               AnchorPane.bottomAnchor="0.0" AnchorPane.leftAnchor="0.0"
                               AnchorPane.rightAnchor="0.0" AnchorPane.topAnchor="0.0">
                        <columns>
                            <TableColumn fx:id="columnCodigoProducto" prefWidth="75.0"
                                         text="Código Barra"/>
                            <TableColumn fx:id="columnDescripcionProducto" prefWidth="75.0"
                                         text="Descripción"/>
                            <TableColumn fx:id="columnPrecioCompraProducto" prefWidth="75.0"
                                         text="Precio de Compra"/>
                            <TableColumn fx:id="columnStockProducto" prefWidth="75.0" text="Stock"/>
                            <TableColumn fx:id="columnRubroProducto" prefWidth="75.0" text="Rubro"/>
                            <TableColumn fx:id="columnMarcaProducto" prefWidth="75.0" text="Marca"/>
                        </columns>
                        <columnResizePolicy>
                            <TableView fx:constant="CONSTRAINED_RESIZE_POLICY"/>
                        </columnResizePolicy>
                    </TableView>
                </AnchorPane>
            </VBox>
        </AnchorPane>
        <AnchorPane layoutX="10.0" layoutY="298.0" maxHeight="-Infinity" minHeight="-Infinity" prefHeight="50.0"
                    prefWidth="500.0">
            <HBox alignment="CENTER_RIGHT" layoutX="365.0" layoutY="13.0" spacing="15.0"
                  AnchorPane.rightAnchor="15.0">
                <Button fx:id="btnCancelar" mnemonicParsing="false" onAction="#handleBtnCancelar"
                        text="Cancelar">
                    <graphic>
                        <FontAwesomeIconView glyphName="TIMES_CIRCLE" size="15.0"/>
                    </graphic>
                </Button>
                <Button fx:id="btnGuardar" mnemonicParsing="false" onAction="#handleBtnGuardar"
                        text="Guardar">
                    <graphic>
                        <FontAwesomeIconView glyphName="SAVE" size="15.0"/>
                    </graphic>
                </Button>
            </HBox>
        </AnchorPane>
    </VBox>
</AnchorPane>
