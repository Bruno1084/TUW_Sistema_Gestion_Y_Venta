<AnchorPane id="anchorPaneMain" prefHeight="560.0" prefWidth="885.0" stylesheets="@../../css/productos.css" xmlns="http://javafx.com/javafx/24.0.1" xmlns:fx="http://javafx.com/fxml/1" fx:controller="com.controller.add.AddProductoController">
    <ScrollPane fitToWidth="true" prefHeight="560.0" prefWidth="885.0" AnchorPane.bottomAnchor="0.0" AnchorPane.leftAnchor="0.0" AnchorPane.rightAnchor="0.0" AnchorPane.topAnchor="0.0">
